# Kommandozentrale — Schlüssel-Vorlage.
#
# SO WIRD SIE ZU DEINER: Datei kopieren nach .env (gleicher Ordner) und nur die
# Zeilen ausfüllen, deren Quelle du nutzt. Leere Zeilen = Quelle bleibt aus.
# Die .env steht in der .gitignore und verlässt deinen Rechner nie.

# ── Google (Search Console + Analytics) ──────────────────────────
# EINE Anmeldung für beide Quellen. Anleitungen:
# datenquellen/google-search-console.md + datenquellen/google-analytics.md
# Refresh-Token erzeugt dir: node starter/werkzeuge/google-login.mjs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Umami (Besucherzahlen-Alternative zu Google Analytics) ────────
# → datenquellen/umami.md
# Variante A: Umami Cloud (nur den API-Schlüssel eintragen)
UMAMI_API_KEY=
# Variante B: selbst gehostetes Umami (alle drei Zeilen)
UMAMI_URL=
UMAMI_BENUTZER=
UMAMI_PASSWORT=

# ── Stripe (Umsatz) ─────────────────────── datenquellen/stripe.md
# Bitte einen EINGESCHRÄNKTEN Schlüssel (rk_…, nur Charges: Lesen).
# Mehrere Konten: durch Komma trennen.
STRIPE_API_KEY=

# ── YouTube (Kanalzahlen) ───────────────── datenquellen/youtube.md
YT_API_KEY=
YT_KANAL=
